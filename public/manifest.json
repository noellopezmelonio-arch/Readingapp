{
  "id": "/",
  "name": "Reading App",
  "short_name": "Reading",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/screenshot-wide.svg",
      "sizes": "1200x600",
      "type": "image/svg+xml",
      "form_factor": "wide"
    },
    {
      "src": "/screenshots/screenshot-portrait.svg",
      "sizes": "400x800",
      "type": "image/svg+xml"
    }
  ]
}
